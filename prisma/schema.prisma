generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supavisor :6543) for the running app.
  url       = env("DATABASE_URL")
  // Direct connection (:5432) — migrations only.
  directUrl = env("DIRECT_URL")
}

// ─── Auth (better-auth Prisma adapter) ───────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// When this doctor last cleared their notification feed (issue #123).
  ///
  /// The feed is a read over `AuditEvent`, which is append-only, so "clear"
  /// cannot mean "delete": the audit rows are the tamper-evident record and
  /// must survive. This marks a point in time and the feed returns only what
  /// happened after it, which hides the notifications without touching the
  /// log they are derived from.
  notificationsClearedAt DateTime?

  /// Adopted clinical-records retention period, in whole years (#80).
  ///
  /// Null means the data controller has not reviewed and adopted a period yet.
  /// That is a real state and must not silently read as `RETENTION_DEFAULT_YEARS`
  /// from `@shared/types`: the default is a convention offered for review, not a
  /// legal determination, and collapsing the two would record a decision nobody
  /// made.
  ///
  /// **Nothing enforces this column.** There is no retention job, no TTL, and no
  /// deletion sweep; erasure stays the doctor-initiated tombstone it already was.
  /// This stores the decision only.
  retentionYears Int?

  sessions      Session[]
  accounts      Account[]
  consultations Consultation[]
  patients      Patient[]
  auditEvents   AuditEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// better-auth's rate-limit counters. Persisted rather than in-memory because
/// the API runs on a free Render instance that spins down when idle — an
/// in-memory limiter resets on every cold start, which is exactly when a
/// brute-force attempt would resume.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Clinical domain ─────────────────────────────────────────────────────────

enum ConsultationStatus {
  draft
  analyzing
  awaiting_review
  approved
}

enum NoteTemplate {
  soap
  malaysian
}

enum CaptureMode {
  ambient
  manual
}

/// A single simulated GP consultation. `approved` is only reachable through an
/// explicit doctor action — nothing auto-approves.
/// A registered patient, created at reception before the consultation begins.
///
/// **The first longitudinal PHI store in this system.** `Consultation` holds
/// five PHI columns, but every one of them is *derived* from a transcript. The
/// columns here are entered by a human and are the identity itself, which is a
/// stricter class and is why all four are erasable.
///
/// It exists because the clinic workflow it models is real: reception writes a
/// card, the card goes to the doctor, the consultation is filed against it.
/// Modelling that also makes de-identification exact rather than probabilistic
/// — a registered patient supplies a known identifier list, so the request
/// vault can be seeded with real values and `deid/`'s pattern detection is
/// demoted to a backstop for whatever was never registered.
model Patient {
  id String @id @default(cuid())

  /// Owning doctor. Every read path scopes on this, exactly as `Consultation`
  /// does, and for the same reason: ownership is the only authorisation
  /// boundary in the system and a second entity must not introduce a second
  /// rule. `Restrict` rather than `Cascade` because deleting a doctor must not
  /// silently destroy patient records that consultations still chain audit
  /// events against.
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  /// All four are PHI and all four are nulled by erasure.
  ///
  /// `nric` is the strongest identifier the system holds and is the reason this
  /// table is treated as a higher class than `Consultation`. `age` is stored
  /// rather than a date of birth deliberately: `deid/` detects DOB as a direct
  /// identifier while treating age as a clinical attribute the model needs, and
  /// storing the weaker of the two is that same line drawn one layer earlier.
  name   String?
  nric   String?
  age    Int?
  gender PatientGender?

  /// Tombstone, with the same semantics as `Consultation.erasedAt`.
  ///
  /// The row survives erasure because `AuditEvent` chains on ids and deleting
  /// it would break tamper evidence — the constraint that made #64 a tombstone
  /// rather than a delete. Erasing a patient must also erase their
  /// consultations, since the transcripts carry the same identity; nothing
  /// wires that to a retention policy yet, because the retention period is an
  /// owner decision (#80) and inventing one here would be inventing a legal
  /// position.
  erasedAt DateTime?

  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, createdAt])
  @@map("patient")
}

model Consultation {
  id       String             @id @default(cuid())
  status   ConsultationStatus @default(draft)
  erasedAt DateTime?

  /// Owning doctor. Every read path scopes on this; see the authz helper.
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// The registered patient this visit belongs to, when one exists.
  ///
  /// Nullable, and staying nullable. Every consultation created before
  /// registration shipped has no patient, and backfilling them would mean
  /// inventing an identity for a record whose transcript is the only evidence
  /// of who it concerned. The four capture modes that do not start from the
  /// queue — paste, upload, fixture, and an ad-hoc recording — also have no
  /// patient by design, and refusing them would push work outside the system.
  ///
  /// `Restrict`, so a patient holding visits cannot be hard-deleted out from
  /// under them. Erasure is the tombstone path, not this one.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// The record's filing name, shown wherever the consultation is listed.
  ///
  /// **A fourth PHI column, and erased with the other three.** It is derived
  /// from the analysis at first run and freely editable afterwards, so a doctor
  /// will put a patient's name in it; that is the feature working, not a
  /// misuse. `eraseConsultation` nulls it alongside `transcript`, `analysis`
  /// and `editedNote`, and the same rule applies to anything added here later.
  ///
  /// Null means never named, and the UI falls back to the created timestamp
  /// rather than storing one, so an un-analysed draft has no title to erase and
  /// a title always means somebody or something chose it.
  ///
  /// Never reaches a provider. It is composed in-process from assertions that
  /// already passed the evidence check, and no prompt reads it.
  title String?

  /// Transcript turns, shape validated by TranscriptSchema in @shared/types.
  transcript Json?
  /// ConsultationAnalysisSchema — regenerated on re-analysis.
  analysis   Json?
  /// Doctor's edited copy of the note. Kept separate so the AI output and the
  /// approved clinical record are never conflated.
  editedNote Json?

  /// Presentation order selected for this consultation. It contains no
  /// clinical content and remains switchable after approval.
  noteTemplate            NoteTemplate @default(soap)
  /// Capture path selected for this consultation. A new consultation opens in
  /// `ambient`; the choice is locked once a transcript exists.
  captureMode             CaptureMode  @default(ambient)
  /// PHI-bearing clinician edits to the canonical eight-field note.
  /// Erasure must null this beside `analysis` and `editedNote`.
  editedMedicalRecordNote Json?

  /// `Prescription[]` from @shared/types: medications the doctor dictated and
  /// then confirmed (`docs/decisions.md` D-001). Doctor-authored, and distinct
  /// from the model-extracted `operational.medicationsDispensed` inside
  /// `analysis` for that reason.
  ///
  /// A fifth PHI column, and erased with the other four. Never reaches a
  /// provider: this path runs no model at all.
  prescriptions           Json?

  /// Array of `RedFlag.id` the doctor has acknowledged. Acknowledgment is
  /// additive only — a red flag is never removed or downgraded by it.
  ///
  /// Superseded by `redFlagDispositions` for consultations reviewed after that
  /// shipped, and kept because older rows carry only this form. A row with no
  /// dispositions projects these forward as `acknowledged`, so both are read
  /// and neither is migrated.
  acknowledgedRedFlagIds Json?
  /// Array of `InformationGap.id` the doctor has marked as reviewed.
  reviewedGapIds         Json?

  /// The doctor's decision per red flag: acknowledged, dismissed with a reason,
  /// or not clinically applicable (issue #10).
  ///
  /// A decision never alters the finding. The red flag stays in `analysis`
  /// exactly as the rules engine produced it, which is what keeps the
  /// never-removed-or-downgraded invariant above true even though a doctor can
  /// now dismiss one. `AuditEvent` remains the authority for how a decision
  /// changed over time; this column holds only the current state.
  redFlagDispositions Json?
  /// The same, per `InformationGap.id`.
  gapDispositions     Json?

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  auditEvents AuditEvent[]
  audio       ConsultationAudio?

  @@index([doctorId, status])
  @@map("consultation")
}

/// The consultation recording, kept only while the doctor may still need it to
/// check what the recogniser wrote (#293).
///
/// **The most sensitive data in this system.** A voice is an identifier in its
/// own right, so unlike every text column this cannot be de-identified, and it
/// must never reach a provider. It is not part of the clinical record: the
/// approved note is. This exists so a doctor can verify a sentence before
/// standing behind it, and it is destroyed once they have.
///
/// **A table of its own, not a column on `Consultation`, for two reasons.**
/// A `Bytes` column would be pulled into every ordinary read of a consultation
/// that did not name an explicit `select`, which is most of them, so a few MB
/// of audio would ride along with every list and detail fetch. And erasure here
/// is a real delete rather than the tombstone the clinical columns take: there
/// is no audit reason to keep an emptied audio row, and a row that is gone
/// cannot be read back by a query that forgot a filter.
///
/// Retention is not decided here. `expiresAt` comes from `AUDIO_RETENTION_HOURS`,
/// which has no default: with it unset nothing is ever stored. See
/// `backend/src/config/env.ts`.
model ConsultationAudio {
  /// Also the primary key: one recording per consultation, enforced by the schema.
  consultationId String       @id
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  data     Bytes
  /// The container it was captured in, so it can be served back as it arrived.
  mimeType String

  /// When it stops being served and becomes eligible for sweeping. Indexed
  /// because the sweep queries on it and nothing else.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("consultation_audio")
}

/// Append-only audit trail. Records identifiers and event types only — never
/// transcript bodies, note contents, or de-identification vault entries.
model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  createdAt DateTime @default(now())

  /// Append order. Used only to find the chain head cheaply and without ties;
  /// `prevHash` is what actually defines the order of the chain.
  seq Int @unique @default(autoincrement())

  /// Hash of the preceding row, or 'genesis' for the first chained row. Unique,
  /// so two concurrent appends cannot silently fork the chain. Null on rows
  /// written before the chain existed (issue #27, docs/trd.md §15).
  prevHash String? @unique
  /// This row's hash over ids and event type only, never `metadata`.
  hash     String?

  /// Detector labels that fired during de-identification, e.g. ["NRIC","NAME"].
  /// Labels only, never values.
  metadata Json?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@index([consultationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_event")
}

/// Recorded sex, as stated at registration.
///
/// Kept because suggestion and red-flag reasoning differ by it, so a note
/// generated without it is wrong rather than merely vague. Mirrors
/// `PatientGenderSchema` in `@shared/types`.
enum PatientGender {
  male
  female
  other
}

// ─── Guideline retrieval (#220, #225) ────────────────────────────────────────

/// One ingested guideline document, today a Malaysian CPG from the Academy of
/// Medicine portal. Holds provenance only; the text lives in its chunks.
model GuidelineDocument {
  id            String   @id
  title         String
  publisher     String
  year          Int
  sourceUrl     String
  jurisdiction  String
  sourceLicence String
  sha256        String
  /// Object path in the Supabase Storage bucket, null until uploaded.
  storagePath   String?
  /// Clinical profiles this document may be retrieved for. Empty means never:
  /// a document is citable only where an operator has scoped it (#220).
  profiles      String[] @default([])
  /// Operator's licence decision from the manifest, not a code default.
  verbatimAllowed Boolean @default(false)
  pageCount     Int
  ingestedAt    DateTime @default(now())

  chunks GuidelineChunk[]

  @@map("guideline_document")
}

/// A retrievable span of a guideline document. `embedding` and `tsv` are
/// written by raw SQL in the ingestion script, since Prisma cannot type them;
/// `tsv` is a generated column (see the migration).
model GuidelineChunk {
  id         String  @id
  documentId String
  document   GuidelineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int
  ordinal    Int
  heading    String?
  text       String
  /// True when the page had no text layer and the text came from Tesseract.
  ocr        Boolean @default(false)
  embedding  Unsupported("vector(1024)")?
  tsv        Unsupported("tsvector")?

  @@index([documentId, ordinal])
  @@map("guideline_chunk")
}
