# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection (Supavisor, port 6543) — used by the app at runtime.
# Prisma needs pgbouncer=true on the pooled URL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_PASSWORD=<password>
# Direct connection (port 5432) — used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ─── Demo accounts ────────────────────────────────────────────────────────────
# Shared guest account behind "Sign in as guest". Leave both blank to disable
# the guest route entirely — it 404s when they are unset.
# Every guest shares this one account and therefore sees the same consultations;
# that is a deliberate, accepted trade-off for the demo, stated in the sign-in UI.
GUEST_EMAIL=guest@catatmd.demo
GUEST_PASSWORD=

# Password for the two seeded demo doctors, used by `bun run db:seed` only.
SEED_DOCTOR_PASSWORD=

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Which adapter LLMClient loads. One of: qwen | gemini | deepseek
#
#   qwen     — DEFAULT. Alibaba Model Studio, Singapore endpoint. Demo + proposal path.
#   gemini   — LOCAL DEV ONLY, SYNTHETIC DATA ONLY. Google's free-tier terms permit
#              use of submitted content for product improvement and human review.
#              Never point this at anything that could resemble real patient data.
#   deepseek — benchmarking only. Hosted API processes and stores data in the PRC;
#              raises a PDPA 2010 s.129 cross-border transfer question.
LLM_PROVIDER=qwen

# Qwen — Alibaba Cloud Model Studio (International / Singapore, OpenAI-compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash

# Gemini — local dev only, see warning above
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek — benchmarking only, see warning above
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── De-identification boundary ───────────────────────────────────────────────
# fail-closed: when true, LLMClient refuses any payload that did not pass through
# the de-identification gate. Never set this to false outside a unit test.
DEID_FAIL_CLOSED=true
