# ─── Knowledge graph ──────────────────────────────────────────────────────────
# Commit only the queryable graph + human-readable report; everything else is
# regenerable locally via `graphify update .` (see the post-commit hook).
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# ─── Clinical data guard ──────────────────────────────────────────────────────
# Nothing resembling patient data belongs in this repo. Synthetic fixtures live
# in backend/src/fixtures/ and are committed deliberately.
*.phi.json
/transcripts/
/patient-data/
.vercel
.gstack/

# ─── Diagram exports ──────────────────────────────────────────────────────────
# The .drawio sources and the .png the README embeds are committed. The .svg
# exports are not: draw.io inlines every icon as a base64 raster, so they are
# ~1MB each, gain nothing over the .png, and nothing references them.
# Regenerate with:
#   drawio --export --format svg --output <out>.svg <src>.drawio
docs/assets/*.drawio.svg

# ─── Agent worktrees ──────────────────────────────────────────────────────────
# Isolated worktrees for parallel sessions that would otherwise collide in one
# working tree. `claude --worktree <name>` creates them here; never committed.
# This is Claude Code's native location, so no WorktreeCreate hook is needed.
#
# No trailing slash, deliberately. A "dir/" pattern only matches a path git
# already knows is a directory, so `git check-ignore .claude/worktrees` fails
# before the directory exists, which is precisely when a skill tests it.
.claude/worktrees

# Eval reports are generated output, one per run
evals/reports/
